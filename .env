# Alamat backend FastAPI. Untuk lokal pakai 127.0.0.1 (BUKAN "localhost":
# di Windows bisa lambat sekitar 2 detik). Saat deploy, ganti dengan URL backend-mu.
VITE_API_BASE_URL=https://stewart-batteries-seventh-lean.trycloudflare.com

# true = pakai data contoh (tanpa backend), false = pakai backend asli
VITE_USE_DUMMY=false
